<odoo>
    <record id="fr_directory_line_form" model="ir.ui.view">
        <field name="model">fr.directory.line</field>
        <field name="inherit_id" ref="l10n_fr_einvoicing.fr_directory_line_form" />
        <field name="arch" type="xml">
            <group name="main" position="after">
                <group
                    name="company"
                    string="Company Settings"
                    attrs="{'invisible': [('belongs_to_company_id', '=', False)]}"
                >
                    <field name="belongs_to_company_id" invisible="1" />
                    <field name="no_vat_deduction" />
                    <field name="purchase_journal_id" />
                </group>
            </group>
        </field>
    </record>
</odoo>
