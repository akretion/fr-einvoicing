<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_fr_einvoicing.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <div id="fr_ctc_directory_sync_on_invoice_post" position="after">
                <div
                    id="fr_ctc_directory_sync_on_sale_order_confirm"
                    class="col-12 col-lg-6 o_setting_box"
                >
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label for="fr_ctc_directory_sync_on_sale_order_confirm" />
                        <div class="text-muted">
                            <field
                                name="fr_ctc_directory_sync_on_sale_order_confirm"
                                widget="radio"
                            />
                        </div>
                    </div>
                </div>
                <div
                    id="fr_ctc_directory_sync_on_sale_order_confirm_days"
                    class="col-12 col-lg-6 o_setting_box"
                    attrs="{'invisible': ['|', ('fr_ctc_directory_sync_on_sale_order_confirm', '=', False), ('fr_ctc_directory_sync_on_sale_order_confirm', '=', 'no')]}"
                >
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label for="fr_ctc_directory_sync_on_sale_order_confirm_days" />
                        <div id="fr_ctc_directory_sync_on_sale_order_confirm_days">
                            <field
                            name="fr_ctc_directory_sync_on_sale_order_confirm_days"
                            class="oe_inline"
                        /> days
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
