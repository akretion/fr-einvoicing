<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_fr_einvoicing.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <setting id="fr_ctc_directory_sync_on_invoice_post" position="after">
                <setting id="fr_ctc_directory_sync_on_sale_order_confirm">
                    <field
                        name="fr_ctc_directory_sync_on_sale_order_confirm"
                        widget="radio"
                    />
                </setting>
                <setting
                    id="fr_ctc_directory_sync_on_sale_order_confirm_days"
                    invisible="not fr_ctc_directory_sync_on_sale_order_confirm or fr_ctc_directory_sync_on_sale_order_confirm == 'no'"
                >
                    <label for="fr_ctc_directory_sync_on_sale_order_confirm_days" />
                    <div id="fr_ctc_directory_sync_on_sale_order_confirm_days">
                                        <field
                        name="fr_ctc_directory_sync_on_sale_order_confirm_days"
                        class="oe_inline"
                    /> days
                                </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
