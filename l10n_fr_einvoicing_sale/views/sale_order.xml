<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_commercial_partner.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_invoice_id" position="after">
                <field name="fr_directory_company_entity_type" invisible="1" />
                <field name="fr_directory_partner_invoice_entity_type" invisible="1" />
                <field
                    name="fr_directory_line_id"
                    attrs="{'invisible': ['|', ('fr_directory_company_entity_type', '!=', 'private'), ('fr_directory_partner_invoice_entity_type', 'not in', ('public', 'private'))], 'required': [('fr_directory_company_entity_type', '=', 'private'), ('fr_directory_partner_invoice_entity_type', 'in', ('public', 'private')), ('state', 'in', ('sale', 'done'))]}"
                />
            </field>
        </field>
    </record>
</odoo>
