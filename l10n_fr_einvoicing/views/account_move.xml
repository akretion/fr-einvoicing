<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_invoice_en16931.view_move_form" />
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="before">
                <!-- fr_directory_line_id is required only when invoice is in draft state
                to avoid blocking old posted invoices -->
                <field
                    name="fr_directory_line_id"
                    attrs="{'invisible': ['|', '|', ('move_type', 'not in', ('out_invoice', 'out_refund')), ('fr_directory_company_entity_type', '!=', 'private'), ('fr_directory_partner_entity_type', 'not in', ('public', 'private'))], 'required': [('fr_einvoicing_required', '!=', False), ('state', '=', 'draft')], 'readonly': [('state', '!=', 'draft')]}"
                />
            </field>
            <button name="action_invoice_sent" position="after">
                <button
                    name="%(fr_einvoicing_event_manual_action)d"
                    type="action"
                    attrs="{'invisible': ['|', '|', '|', ('fr_directory_company_entity_type', '!=', 'private'), ('fr_directory_partner_entity_type', 'not in', ('public', 'private')), ('fr_einvoicing_flow_id', '=', False), ('state', 'not in', ('draft', 'posted'))]}"
                    string="New Event"
                    groups="account.group_account_invoice"
                />
            </button>
            <div role="alert" position="after">
                <div
                    class="alert alert-info w-100 d-flex align-items-center gap-1"
                    attrs="{'invisible': ['|', '|', ('fr_einvoicing_required', '=', False), ('state', '!=', 'posted'), ('fr_einvoicing_flow_state',  'not in', ('created', 'generated'))]}"
                    role="alert"
                >
                    <span
                    >This invoice will be sent automatically to the accredited platform. </span>
                    <button
                        class="btn-link"
                        style="padding:0"
                        name="fr_ctc_send_invoice_immediately_button"
                        type="object"
                    >Click here to send it immediately</button>
                </div>
            </div>
            <group id="einvoicing-main" position="inside">
                <group
                    name="fr-einvoicing-grp"
                    attrs="{'invisible': ['|', '|', ('fr_directory_company_entity_type', '!=', 'private'),  ('fr_directory_partner_entity_type', 'not in', ('public', 'private')), ('move_type', '=', 'entry')]}"
                    string="France eInvoicing"
                >
                    <field
                        name="company_fr_directory_line_id"
                        attrs="{'readonly': ['|', ('move_type',  'in', ('in_invoice', 'in_refund')), '&amp;', ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '!=', 'draft')]}"
                    />
                    <!-- I can't display field 'fr_directory_line_id' for supplier invoices here
                            like in v18, because, in v16, if we have the same field at 2 places
                    in a form view, it causes some problems. As this field is not very important
                            for supplier invoices, we just drop it -->
                    <field
                        name="fr_directory_line_identifier"
                        attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('fr_directory_line_id', '!=', False)], 'readonly': ['|', ('move_type', 'in', ('in_invoice', 'in_refund')), '&amp;', ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '!=', 'draft')]}"
                    />
                    <button
                        name="fr_ctc_get_readable_invoice_button"
                        type="object"
                        string="Get Readable Invoice"
                        colspan="2"
                        attrs="{'invisible': [('fr_einvoicing_show_readable_invoice_button', '=', False)]}"
                    />
                    <field
                        name="fr_einvoicing_show_readable_invoice_button"
                        invisible="1"
                    />
                    <field name="fr_einvoicing_flow_id" />
                    <field
                        name="fr_einvoicing_flow_submitted_at"
                        attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}"
                    />

                    <field name="fr_directory_company_entity_type" invisible="1" />
                    <field name="fr_directory_partner_entity_type" invisible="1" />
                    <field name="fr_einvoicing_required" invisible="0" />
                    <field name="fr_einvoicing_flow_state" invisible="1" />
                    <field name="company_partner_id" invisible="1" />
                </group>
            </group>
            <group id="einvoicing-main" position="after">
                <group
                    name="fr-einvoicing-event"
                    string="Events"
                    attrs="{'invisible': ['|', '|', ('fr_directory_company_entity_type', '!=', 'private'), ('fr_directory_partner_entity_type', 'not in', ('public', 'private')), ('move_type', '=', 'entry')]}"
                >
                    <field name="fr_einvoicing_event_ids" nolabel="1" colspan="2" />
                </group>
            </group>
        </field>
    </record>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="fr_einvoicing_last_event_id"
                    widget="badge"
                    decoration-info="fr_einvoicing_last_event_decoration == 'info'"
                    decoration-success="fr_einvoicing_last_event_decoration == 'success'"
                    decoration-warning="fr_einvoicing_last_event_decoration == 'warning'"
                    decoration-danger="fr_einvoicing_last_event_decoration == 'danger'"
                    decoration-muted="fr_einvoicing_last_event_decoration == 'muted'"
                />
                <field
                    name="fr_einvoicing_flow_state"
                    widget="badge"
                    optional="show"
                    decoration-info="fr_einvoicing_flow_state == 'sent'"
                    decoration-success="fr_einvoicing_flow_state == 'done'"
                    decoration-warning="fr_einvoicing_flow_state in ('generated', 'downloaded')"
                    decoration-danger="fr_einvoicing_flow_state in ('error', 'ap_unknown')"
                />
                <field name="fr_einvoicing_last_event_decoration" invisible="1" />
            </field>
        </field>
    </record>
    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="status" position="after">
                <filter
                    name="flow_state_groupby"
                    string="Flow State"
                    context="{'group_by': 'fr_einvoicing_flow_state'}"
                />
            </filter>
        </field>
    </record>
</odoo>
