<odoo>

        <record id="fr_einvoicing_log_form" model="ir.ui.view">
                <field name="model">fr.einvoicing.log</field>
                <field name="arch" type="xml">
                        <form>
                                <group name="main">
                                    <group name="main-left">
                                        <field name="create_date" string="Date" />
                                        <field name="company_id" groups="base.group_multi_company" />
                                        <field name="type" />
                                        <field name="origin" />
                                </group>
                                    <group name="main-right">
                                        <field
                            name="status"
                            widget="badge"
                            decoration-success="status == 'success'"
                            decoration-danger="status == 'failure'"
                            decoration-warning="status == 'success_warn'"
                        />
                                        <field name="new_count" />
                                        <field name="updated_count" />

                                </group>
                                </group>
                                <group name="logs" string="Logs">
                                        <field name="logs" nolabel="1" colspan="2" />
                                </group>
                        </form>
                </field>
        </record>

    <record id="fr_einvoicing_log_list" model="ir.ui.view">
                <field name="model">fr.einvoicing.log</field>
                <field name="arch" type="xml">
                        <list decoration-danger="status == 'failure'">
                                <field name="create_date" string="Date" />
                                <field name="company_id" groups="base.group_multi_company" />
                                        <field name="type" />
                                        <field name="origin" optional="show"/>
                                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'success'"
                    decoration-danger="status == 'failure'"
                    decoration-warning="status == 'success_warn'"
                />
                                <field
                    name="new_count"
                    optional="show"
                    string="New"
                    sum="1"
                />
                                <field
                    name="updated_count"
                    optional="show"
                    string="Updated"
                    sum="1"
                />
                        </list>
                </field>
        </record>

        <record id="fr_einvoicing_log_search" model="ir.ui.view">
                <field name="model">fr.einvoicing.log</field>
                <field name="arch" type="xml">
                        <search>
                                <filter name="directory" string="Directory" domain="[('type', '=', 'directory')]"/>
                                <separator />
                                <filter
                    name="success"
                    string="Success"
                    domain="[('status', '=', 'success')]"
                />
                                <filter
                    name="success_warn"
                    string="Success with Warnings"
                    domain="[('status', '=', 'success_warn')]"
                />
                                <filter
                    name="failure"
                    string="Failure"
                    domain="[('status', '=', 'failure')]"
                />
                                <group name="groupby">
                                        <filter
                        name="create_date_groupby"
                        string="Date"
                        context="{'group_by': 'create_date'}"
                    />
                                        <filter
                        name="status_groupby"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                                        <filter
                        name="type_groupby"
                        string="Type"
                        context="{'group_by': 'type'}"
                    />
                                </group>
                        </search>
                </field>
        </record>

        <record
        id="fr_einvoicing_log_action"
        model="ir.actions.act_window"
    >
                <field name="name">France eInvoicing Logs</field>
                <field name="res_model">fr.einvoicing.log</field>
                <field name="view_mode">list,form</field>
        </record>

        <menuitem id="fr_einvoicing_log_menu" action="fr_einvoicing_log_action" parent="fr_einvoicing_root" sequence="200"/>

</odoo>
