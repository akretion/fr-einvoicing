<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <group name="misc" position="after">
                <group
                    name="fr_einvoicing"
                    string="eInvoicing for France"
                    attrs="{'invisible': ['|', ('parent_id', '!=', False), ('is_france_country', '=', False)]}"
                >
                    <field
                        name="fr_directory_entity_type"
                        widget="badge"
                        decoration-warning="fr_directory_entity_type == 'private_inactive'"
                        decoration-success="fr_directory_entity_type == 'private'"
                        decoration-danger="fr_directory_entity_type == 'no'"
                        decoration-info="fr_directory_entity_type == 'public'"
                    />
                    <field name="fr_directory_name" />
                    <field
                        name="fr_directory_closed"
                        attrs="{'invisible': [('fr_directory_closed', '=', False)]}"
                    />
                    <field
                        name="fr_directory_siren"
                        attrs="{'invisible': [('fr_directory_siren', '=', False)]}"
                    />
                    <field
                        name="fr_directory_siret"
                        attrs="{'invisible': [('fr_directory_entity_type', '!=', 'public')]}"
                    />
                    <field name="fr_directory_last_sync_date" />
                    <field
                        name="default_fr_directory_line_id"
                        attrs="{'invisible': [('fr_directory_line_show', '=', False)]}"
                    />
                    <div colspan="2" id="directory_lines">
                        <button
                            name="%(l10n_fr_einvoicing.fr_directory_line_action)d"
                            context="{'search_default_partner_id': id, 'search_default_active': True}"
                            class="oe_stat_button"
                            type="action"
                        >
                            <field
                                name="fr_directory_line_active_count"
                                string="Active Directory Lines"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <field name="fr_directory_line_show" invisible="1" />
                    <field name="fr_directory_entity_changed_warning" invisible="1" />
                    <field
                        name="fr_directory_show_warning_missing_siren"
                        invisible="1"
                    />
                    <button
                        name="fr_directory_sync_button"
                        type="object"
                        string="Directory Sync"
                        colspan="2"
                    />
                </group>
                <group
                    name="fr_einvoicing_child"
                    string="eInvoicing for France"
                    attrs="{'invisible': ['|', ('parent_id', '=', False), ('is_france_country', '=', False)]}"
                >
                    <field
                        name="default_fr_directory_line_id"
                        attrs="{'invisible': [('fr_directory_line_show', '=', False)]}"
                    />
                    <div colspan="2">
                        <p>Other parameters are managed on <button
                            name="open_commercial_entity"
                            type="object"
                            string="the parent company"
                            class="oe_link"
                        /></p>
                    </div>
                </group>
            </group>
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='email']"
                position="before"
            >
                <field
                    name="default_fr_directory_line_id"
                    attrs="{'invisible': [('fr_directory_line_show', '=', False)]}"
                />
                <field name="fr_directory_line_show" invisible="1" />
                <field name="commercial_partner_id" invisible="1" />
            </xpath>
            <!--
                                  <div name="button_box" position="inside">
                                          <button name="%(l10n_fr_einvoicing.fr_directory_line_action)d" context="{'search_default_partner_id': id, 'search_default_active': True}" class="oe_stat_button" type="action" icon="fa-newspaper-o" invisible="not fr_directory_line_show">
                                                  <field string="Active Directory Lines" name="fr_directory_line_active_count" widget="statinfo" />
                                          </button>
        </div> -->
            <div role="alert" position="after">
                <div
                    name="fr_directory_closed"
                    attrs="{'invisible': [('fr_directory_show_warning_closed', '=', False)]}"
                    class="alert alert-warning"
                    role="alert"
                >According to the directory, this entity is <strong>closed</strong>.
                    <field name="fr_directory_show_warning_closed" invisible="1" />
                </div>
                <div
                    name="entity_changed_warning"
                    attrs="{'invisible': [('fr_directory_entity_changed_warning', '=', False)]}"
                    class="alert alert-warning"
                    role="alert"
                >
                    <field name="fr_directory_entity_changed_warning" />
                </div>
                <div
                    name="fr_company_without_siren"
                    attrs="{'invisible': [('fr_directory_show_warning_missing_siren', '=', False)]}"
                    class="alert alert-warning"
                    role="alert"
                >You should <strong
                >set a SIREN, SIRET or VAT number</strong> on this France-based entity.
                                    </div>
            </div>
        </field>
    </record>

    <record id="view_partner_tree" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field
                    name="fr_directory_entity_type"
                    widget="badge"
                    decoration-warning="fr_directory_entity_type == 'private_inactive'"
                    decoration-success="fr_directory_entity_type == 'private'"
                    decoration-danger="fr_directory_entity_type == 'no'"
                    decoration-info="fr_directory_entity_type == 'public'"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
