<odoo>
    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="arch" type="xml">
            <!-- xpath is really dirty, because there are multiple occurences of account_file_uploader but the menu section for sale/purchase journal lacks distinctive id= and name= -->
            <xpath
                expr="//widget[@name='account_file_uploader']/../.."
                position="inside"
            >
                <div
                    id="fr_einvoicing_import_flows"
                    t-if="journal_type == 'purchase' || journal_type == 'sale'"
                >
                    <a
                        role="menuitem"
                        type="object"
                        name="fr_einvoicing_run_import"
                    >Import from AP Now</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
