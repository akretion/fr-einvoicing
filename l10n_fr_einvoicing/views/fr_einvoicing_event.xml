<odoo>
    <record id="fr_einvoicing_event_form" model="ir.ui.view">
        <field name="model">fr.einvoicing.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="main-left">
                            <field
                                name="status"
                                widget="badge"
                                decoration-info="status_decoration == 'info'"
                                decoration-success="status_decoration == 'success'"
                                decoration-warning="status_decoration == 'warning'"
                                decoration-danger="status_decoration == 'danger'"
                                decoration-muted="status_decoration == 'muted'"
                            />
                            <field name="datetime" />
                            <field name="date" invisible="1" />
                            <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                invisible="not attachment_ids"
                            />
                        </group>
                        <group name="main-right">
                            <field name="direction" invisible="1" />
                            <field name="status_decoration" invisible="1" />
                            <field name="move_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="flow_id" />
                        </group>
                    </group>
                    <group
                        name="details"
                        string="Reasons and Actions Requested"
                        invisible="not detail_ids"
                    >
                        <field nolabel="1" name="detail_ids">
                            <list>
                                <field name="reason" />
                                <field name="comment" />
                                <field name="action" />
                            </list>
                        </field>
                    </group>
                    <group name="details" string="Payments" invisible="not payment_ids">
                        <field nolabel="1" name="payment_ids">
                            <list>
                                <field name="date" />
                                <field name="amount" />
                                <field name="currency_id" column_invisible="1" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fr_einvoicing_event_list" model="ir.ui.view">
        <field name="model">fr.einvoicing.event</field>
        <field name="arch" type="xml">
            <list decoration-warning="flow_state in ('error', 'ap_unknown')">
                <field
                    name="direction"
                    column_invisible="not context.get('event_main_view')"
                    widget="badge"
                    decoration-info="direction == 'in'"
                    decoration-warning="direction == 'out'"
                />
                <field
                    name="move_id"
                    column_invisible="not context.get('event_main_view')"
                />
                <field name="datetime" optional="show" string="Issue Date" />
                <field name="date" optional="hide" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status_decoration == 'info'"
                    decoration-success="status_decoration == 'success'"
                    decoration-warning="status_decoration == 'warning'"
                    decoration-danger="status_decoration == 'danger'"
                    decoration-muted="status_decoration == 'muted'"
                />
                <field name="status_decoration" column_invisible="1" />
                <field name="infos" optional="show" />
                <field name="currency_id" column_invisible="1" />
                <field name="amount" invisible="not currency_id" />
                <field name="flow_id" optional="hide" />
                <field
                    name="flow_state"
                    widget="badge"
                    decoration-info="flow_state == 'sent'"
                    decoration-success="flow_state == 'done'"
                    decoration-warning="flow_state in ('generated', 'downloaded')"
                    decoration-danger="flow_state in ('error', 'ap_unknown')"
                />
            </list>
        </field>
    </record>

    <record id="fr_einvoicing_event_search" model="ir.ui.view">
        <field name="model">fr.einvoicing.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id" />
                <separator />
                <filter name="out" string="Out" domain="[('direction', '=', 'out')]" />
                <filter name="in" string="In" domain="[('direction', '=', 'in')]" />
                <separator />
                <filter
                    name="error"
                    string="Flow in Error"
                    domain="[('flow_state', 'in', ('error', 'ap_unknown'))]"
                />
                <group name="groupby">
                    <filter
                        name="status_groupby"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                    <filter
                        name="move_groupby"
                        string="Invoice"
                        context="{'group_by': 'move_id'}"
                    />
                    <filter
                        name="flow_state_groupby"
                        string="Flow State"
                        context="{'group_by': 'flow_state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="fr_einvoicing_event_graph" model="ir.ui.view">
        <field name="model">fr.einvoicing.event</field>
        <field name="arch" type="xml">
            <graph>
                <field name="date" interval="month" />
            </graph>
        </field>
    </record>

    <record id="fr_einvoicing_event_pivot" model="ir.ui.view">
        <field name="model">fr.einvoicing.event</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date" interval="month" type="col" />
                <field name="direction" type="row" />
            </pivot>
        </field>
    </record>

    <record id="fr_einvoicing_event_action" model="ir.actions.act_window">
        <field name="name">Invoice Events</field>
        <field name="res_model">fr.einvoicing.event</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'event_main_view': True}</field>
    </record>

    <menuitem
        id="fr_einvoicing_event_menu"
        action="fr_einvoicing_event_action"
        parent="fr_einvoicing_root"
        sequence="100"
    />
</odoo>
