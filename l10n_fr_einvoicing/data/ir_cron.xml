<odoo noupdate="1">

<record id="fr_directory_update_cron" model="ir.cron">
    <field name="name">FR eInvoicing directory update</field>
    <field name="active" eval="False"/>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">model._fr_directory_sync_cron()</field>
</record>

<record id="fr_einvoicing_send_invoice_cron" model="ir.cron">
    <field name="name">FR eInvoicing send invoices</field>
    <field name="active" eval="False"/>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="state">code</field>
    <field name="code">model._fr_einvoicing_send_invoices_cron()</field>
</record>

</odoo>
