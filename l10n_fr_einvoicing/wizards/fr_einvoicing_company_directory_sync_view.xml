<odoo>
    <record id="fr_einvoicing_company_directory_sync_form" model="ir.ui.view">
        <field name="model">fr.einvoicing.company.directory.sync</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="company_id" invisible="1" />
                    <field name="company_partner_id" />
                    <field
                        name="company_fr_directory_entity_type"
                        attrs="{'invisible': [('company_fr_directory_entity_type', '=', False)]}"
                        widget="badge"
                        decoration-warning="company_fr_directory_entity_type == 'private_inactive'"
                        decoration-success="company_fr_directory_entity_type == 'private'"
                        decoration-danger="company_fr_directory_entity_type == 'no'"
                        decoration-info="company_fr_directory_entity_type == 'public'"
                    />
                    <field
                        name="company_default_fr_directory_line_id"
                        attrs="{'invisible': [('state', '!=', 'select_default_dir_line')], 'required': [('state', '=', 'select_default_dir_line')]}"
                    />
                    <field name="state" invisible="1" />
                </group>
                <group
                    name="error"
                    attrs="{'invisible': [('state', '!=', 'error')]}"
                >
                    <field name="error" nolabel="1" colspan="2" />
                </group>
                <footer>
                    <button
                        name="dir_sync_button"
                        type="object"
                        string="Directory Sync"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'dir_sync')]}"
                    />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                        attrs="{'invisible': [('state', '!=', 'dir_sync')]}"
                    />
                    <button
                        special="cancel"
                        string="Close"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'error')]}"
                    />
                    <button
                        string="Validate"
                        type="object"
                        name="select_default_dir_line_button"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'select_default_dir_line')]}"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="fr_einvoicing_company_directory_sync_action"
        model="ir.actions.act_window"
    >
        <field name="name">France eInvoicing - Company Directory Sync</field>
        <field name="res_model">fr.einvoicing.company.directory.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
