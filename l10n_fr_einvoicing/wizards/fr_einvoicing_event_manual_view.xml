<odoo>
    <record id="fr_einvoicing_event_manual_form" model="ir.ui.view">
        <field name="model">fr.einvoicing.event.manual</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="move_id" />
                    <field name="move_type" />
                    <field
                        name="status_sale"
                        attrs="{'readonly': [('status_readonly', '=', True)], 'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))], 'required': [('move_type', 'in', ('out_invoice', 'out_refund'))]}"
                        string="Status"
                    />
                    <field
                        name="status_purchase"
                        attrs="{'readonly': [('status_readonly', '=', True)], 'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))], 'required': [('move_type', 'in', ('in_invoice', 'in_refund'))]}"
                        string="Status"
                    />
                    <field name="status_readonly" invisible="1" />
                    <field name="detail_required" invisible="1" />
                    <field name="confirm_required" invisible="1" />
                    <field name="attachment_ids" widget="many2many_binary" />
                </group>
                <group
                    name="details"
                    string="Reasons and Actions Requested"
                    attrs="{'invisible': [('detail_required', '=', False)]}"
                >
                    <field name="detail_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                            <field
                                name="reason_dispute"
                                string="Reason"
                                attrs="{'required': [('parent.status_purchase', '=', 'dispute')], 'column_invisible': [('parent.status_purchase', '!=', 'dispute')]}"
                            />
                            <field
                                name="reason_partially_approved"
                                string="Reason"
                                attrs="{'required': [('parent.status_purchase', '=', 'partially_approved')], 'column_invisible': [('parent.status_purchase', '!=', 'partially_approved')]}"
                            />
                            <field
                                name="reason_suspended"
                                string="Reason"
                                attrs="{'required': [('parent.status_purchase', '=', 'suspended')], 'column_invisible': [('parent.status_purchase', '!=', 'suspended')]}"
                            />
                            <field
                                name="reason_refused"
                                string="Reason"
                                attrs="{'required': [('parent.status_purchase', '=', 'refused')], 'column_invisible': [('parent.status_purchase', '!=', 'refused')]}"
                            />
                            <field name="comment" />
                            <field name="action" />
                        </tree>
                    </field>
                </group>
                <div
                    attrs="{'invisible': [('confirm_required', '=', False)]}"
                    class="alert alert-info"
                    role="alert"
                >You must confirm the refusal of the vendor bill/refund, or click on cancel. Reminder: the refusal is <strong
                >definitive</strong>. On the contrary, if you want to block the vendor bill temporarily, you should create an event <em
                >Disputed</em>.
                                  </div>
                <group
                    name="confirm"
                    attrs="{'invisible': [('confirm_required', '=', False)]}"
                >
                    <field name="confirm" />
                </group>
                <footer>
                    <button
                        name="run"
                        type="object"
                        string="Send Event"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record id="fr_einvoicing_event_manual_action" model="ir.actions.act_window">
        <field name="name">New Event</field>
        <field name="res_model">fr.einvoicing.event.manual</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
