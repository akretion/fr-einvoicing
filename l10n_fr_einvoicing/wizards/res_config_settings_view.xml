<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
                <block name="fiscal_localization_setting_container" position="inside">
                        <setting id="fr_accredited_platform" invisible="country_code != 'FR'">
                                <field name="fr_accredited_platform" />
                                <div class="mt16">
                                        <button name="fr_ctc_test_api_button" type="object" string="Test API" class="btn-secondary ps-2 w-100"/>
                                </div>
                    </setting>
                </block>
        </field>
</record>

</odoo>
