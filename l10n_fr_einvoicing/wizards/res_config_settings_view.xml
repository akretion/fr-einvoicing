<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="fiscal_localization_setting_container" position="after">
                <block
                    name="fr_einvoicing"
                    title="France eInvoicing"
                    invisible="country_code != 'FR'"
                >
                    <setting id="fr_ctc_accredited_platform">
                        <field name="fr_ctc_accredited_platform" />
                    </setting>
                    <setting id="fr_ctc_auth_method">
                        <field name="fr_ctc_auth_method" widget="radio" />
                        <div class="mt16">
                            <button
                                name="fr_ctc_authorization_code_onboarding"
                                type="object"
                                string="Onboarding"
                                class="btn-secondary ps-2 w-100"
                                invisible="fr_ctc_auth_method != 'authorization_code'"
                            />
                            <button
                                name="fr_ctc_test_api_button"
                                type="object"
                                string="Test API"
                                class="btn-secondary ps-2 w-100"
                            />
                            <button
                                name="fr_ctc_check_en16931_button"
                                type="object"
                                string="Check config for EN16931 invoicing"
                                class="btn-secondary ps-2 w-100"
                            />
                            <button
                                name="fr_ctc_check_siren_siret_vat_button"
                                type="object"
                                string="Check SIREN/SIRET/VAT validity on all partners"
                                class="btn-secondary ps-2 w-100"
                            />
                            <button
                                name="%(fr_einvoicing_company_directory_sync_action)s"
                                type="action"
                                string="Company Directory Sync"
                                invisible="not fr_ctc_show_company_dir_update_button"
                                class="btn-secondary ps-2 w-100"
                                context="{'default_company_id': company_id}"
                            />
                        </div>
                    </setting>
                    <setting
                        id="fr_ctc_client_id"
                        invisible="fr_ctc_auth_method != 'client_credentials'"
                    >
                        <field name="fr_ctc_client_id" />
                    </setting>
                    <setting
                        id="fr_ctc_client_secret"
                        invisible="fr_ctc_auth_method != 'client_credentials'"
                    >
                        <field name="fr_ctc_client_secret" password="1" />
                    </setting>
                    <setting id="fr_ctc_last_invoice_import_datetime">
                        <field name="fr_ctc_last_flow_import_datetime" />
                    </setting>
                    <setting
                        id="fr_ctc_send_invoice_format"
                        help="eInvoice format used when sending a customer invoice/refund to the accredited platform"
                    >
                        <field name="fr_ctc_send_invoice_format" />
                    </setting>
                    <setting
                        id="fr_ctc_auto_reverse"
                        help="If enabled, Odoo will automatically reverse an invoice on which a refused or rejected event has been received. The reversed invoice will be an internal refund/invoice"
                    >
                        <field name="fr_ctc_auto_reverse" />
                    </setting>
                    <setting
                        id="fr_ctc_event_auto_send_in_hand"
                        help="When vendor bill is imported as draft in Odoo"
                    >
                        <field name="fr_ctc_event_auto_send_in_hand" />
                    </setting>
                    <setting
                        id="fr_ctc_event_auto_send_approved"
                        help="When vendor bill is confirmed"
                    >
                        <field name="fr_ctc_event_auto_send_approved" />
                    </setting>
                    <setting id="fr_ctc_activity_warning_event_user_ids">
                        <field
                            name="fr_ctc_activity_warning_event_user_ids"
                            widget="many2many_tags"
                        />
                    </setting>
                    <setting id="fr_ctc_activity_warning_event_invoice_creator">
                        <field name="fr_ctc_activity_warning_event_invoice_creator" />
                    </setting>
                    <setting id="fr_ctc_activity_warning_event_salesman">
                        <field name="fr_ctc_activity_warning_event_salesman" />
                    </setting>
                    <setting id="fr_ctc_update_partner_if_older_than_days">
                        <label for="fr_ctc_update_partner_if_older_than_days" />
                        <div id="fr_ctc_update_partner_if_older_than_days">
                                <field
                            name="fr_ctc_update_partner_if_older_than_days"
                            class="oe_inline"
                        /> days
                        </div>
                    </setting>
                    <setting
                        id="fr_ctc_update_private_inactive_partner_if_older_than_days"
                    >
                        <label
                            for="fr_ctc_update_private_inactive_partner_if_older_than_days"
                        />
                        <div
                            id="help-fr_ctc_update_private_inactive_partner_if_older_than_days"
                        >Partners that are not active in the directory should be checked more frequently, because they should activate their invoicing address soon.</div>
                        <div
                            id="fr_ctc_update_private_inactive_partner_if_older_than_days"
                        >
                                        <field
                            name="fr_ctc_update_private_inactive_partner_if_older_than_days"
                            class="oe_inline"
                        /> days
                                </div>
                    </setting>
                    <setting id="fr_ctc_directory_sync_on_invoice_post">
                        <field
                            name="fr_ctc_directory_sync_on_invoice_post"
                            widget="radio"
                        />
                    </setting>
                    <setting id="fr_ctc_send_out_invoice">
                        <field name="fr_ctc_send_out_invoice" />
                    </setting>
                    <setting id="fr_ctc_get_in_invoice">
                        <field name="fr_ctc_get_in_invoice" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
