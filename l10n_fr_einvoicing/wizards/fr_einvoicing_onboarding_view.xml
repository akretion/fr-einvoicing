<odoo>

    <record id="fr_einvoicing_onboarding_form" model="ir.ui.view">
        <field name="model">fr.einvoicing.onboarding</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="company_id"/>
                    <field name="accredited_platform"/>
                </group>
                <footer>
                    <button name="redirect" type="object" string="Redirect" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="fr_einvoicing_onboarding_action" model="ir.actions.act_window">
        <field name="name">Onboarding</field>
        <field name="res_model">fr.einvoicing.onboarding</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
