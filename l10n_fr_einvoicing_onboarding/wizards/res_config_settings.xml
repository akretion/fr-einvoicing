<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="fiscal_localization_setting_container" position="after">
                <block
                    name="fr_einvoicing"
                    title="France eInvoicing"
                    invisible="country_code != 'FR'"
                >
                    <setting id="fr_ctc_accredited_platform">
                        <field name="fr_ctc_accredited_platform" />
                    </setting>
                    <setting id="fr_ctc_auth_method">
                        <div class="mt16">
                            <button
                                name="fr_ctc_authorization_code_onboarding"
                                type="object"
                                string="Onboarding"
                                class="btn-secondary ps-2 w-100"
                            />
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
