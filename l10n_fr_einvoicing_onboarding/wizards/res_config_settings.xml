<odoo>

<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account.res_config_settings_view_form" />
    <field name="arch" type="xml">
        <xpath expr="//div[@id='invoicing_settings']" position="after">
            <h2
                    attrs="{'invisible': [('country_code','!=', 'FR')]}"
                >France eInvoicing</h2>
            <div
                    class="row mt16 o_settings_container"
                    attrs="{'invisible': [('country_code','!=', 'FR')]}"
                >
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Accredited Platform</span>
                        <div class="text-muted">
                            Start onboarding for France eInvoicing.
                        </div>
                        <div class="content-group mt8">
                            <field name="fr_ctc_accredited_platform" />
                        </div>
                        <div class="mt16" groups="base.group_erp_manager">
                            <button
                                    name="fr_ctc_authorization_code_onboarding"
                                    type="object"
                                    string="Onboarding"
                                    class="btn-primary"
                                />
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </field>
</record>

</odoo>
