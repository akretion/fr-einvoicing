<odoo>
    <record id="account_invoice_en16931_form" model="ir.ui.view">
        <field name="model">account.invoice.en16931.generate</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="type" invisible="1" />
                    <field name="move_ids" widget="many2many_tags" />
                    <field name="invoice_format" widget="radio" />
                    <field
                        name="archive_format"
                        invisible="type != 'multi'"
                        required="type == 'multi'"
                    />
                </group>
                <footer>
                    <button
                        name="generate_button"
                        type="object"
                        string="Generate"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record id="account_invoice_en16931_action" model="ir.actions.act_window">
        <field name="name">Generate eInvoices</field>
        <field name="res_model">account.invoice.en16931.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
