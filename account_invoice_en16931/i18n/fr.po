msgstr ""
"La TVA '%(tax)s' a son Calcul de taxe configuré comme '%(amount_type)s', quand toutes "
"les TVA doivent être configurées pour un calcul en 'Pourcentage'."

#. module: account_invoice_en16931
#. odoo-python
#: code:addons/account_invoice_en16931/models/account_tax.py:0
msgid ""
"VAT tax '%(tax)s' has UNECE Tax Category '%(categ)s' so it should have a VAT"
" Exemption Reason."
msgstr ""
"La TVA '%(tax)s' a pour catégorie de taxe UNECE '%(categ)s', et devrait donc être "
"configurée avec une cause d'exemption de TVA."

#. module: account_invoice_en16931
#. odoo-python
