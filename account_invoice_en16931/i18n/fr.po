msgstr ""
"La TVA '%(tax)s' a pour catégorie de taxe UNECE '%(categ)s', donc son taux "
"devrait être nul."

#. module: account_invoice_en16931
#. odoo-python
#: code:addons/account_invoice_en16931/models/account_tax.py:0
msgid ""
"VAT tax '%(tax)s' has UNECE Tax Category '%(categ)s' so it's rate (%(rate)s)"
" should be strictly positive."
msgstr "" 
"La TVA '%(tax)s' a pour catégorie de taxe UNECE '%(categ)s', donc son taux "
"devrait être strictement positif."

#. module: account_invoice_en16931
#. odoo-python
#: code:addons/account_invoice_en16931/models/account_tax.py:0
msgid ""
"VAT tax '%(tax)s' has a rate of %(rate)s %%, which is above the known "
