<odoo>
    <!-- the native ir.actions.act_window for account.move.line
        doesn't have "form" in view_mode, that's we have to define one -->
    <record id="account_move_line_action" model="ir.actions.act_window">
        <field name="name">Journal Items</field>
        <field name="res_model">account.move.line</field>
        <field name="path">fr-ereporting-journal-item</field>
        <field name="view_mode">list,pivot,graph,kanban,form</field>
        <field
            name="domain"
        >[('display_type', 'not in', ('line_section', 'line_note'))]</field>
    </record>
</odoo>
