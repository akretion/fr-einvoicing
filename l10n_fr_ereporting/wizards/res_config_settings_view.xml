<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_fr_einvoicing.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <block name="fr_einvoicing" position="after">
                <block
                    name="fr_einvoicing"
                    title="France eReporting"
                    invisible="fr_directory_company_entity_type != 'private'"
                >
                    <setting id="fr_ctc_ereporting_minimize">
                        <field name="fr_ctc_ereporting_minimize" />
                    </setting>
                    <setting id="fr_ctc_ereporting_update_lock_dates">
                        <field name="fr_ctc_ereporting_update_lock_dates" />
                    </setting>

                    <setting
                        id="fr_ctc_ereporting_auto"
                        help="If enabled, make sure that the corresponding Scheduled Action is active with a daily frequency."
                    >
                        <field name="fr_ctc_ereporting_auto" />
                    </setting>
                    <setting
                        id="fr_ctc_ereporting_deadline_days"
                        invisible="not fr_ctc_ereporting_auto"
                    >
                        <field name="fr_ctc_ereporting_deadline_days" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
