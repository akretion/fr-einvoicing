#. module: l10n_fr_ereporting
#: model:mail.template,body_html:l10n_fr_ereporting.fr_ereporting_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" data-o-mail-quote-"
"container=\"1\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 12px; font-"
"family: Arial, Helvetica, sans-serif\">Here are the actions performed "
"automatically for e-Reporting in company <strong>\n"
"                    <t t-out=\"object.display_name\"/>\n"
"                </strong> which is configured with VAT periodicity <strong>\n"
"                    <t t-out=\"dict(object.fields_get('fr_vat_periodicity', "
"'selection')['fr_vat_periodicity']['selection'])[object."
"fr_vat_periodicity]\"/>\n"
"                </strong>.</p>\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; "
"width: 100%; text-align: center;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;"
"\">e-Reporting Type and Period</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;"
"\">Creation</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;"
"\">Generation &amp; Sending</th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"ctx['mail_coreinfo'].items()\" t-"
"as=\"line\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"line[0]\"/>\n"
"                            </td>\n"
"                            <t t-if=\"line[1]['created']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black; background-color: #a1ffba\">Created</td>\n"
"                            </t>\n"
"                            <t t-if=\"not line[1]['created']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black;\">Already existing</td>\n"
"                            </t>\n"
"\n"
"                            <t t-if=\"line[1]['gen_sent']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black; background-color: #a1ffba\">Successfully generated and sent</td>\n"
"                            </t>\n"
"                            <t t-if=\"not line[1]['gen_sent']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black; background-color: #ffc694\">\n"
"                                    <t t-out=\"line[1]['gen_sent_error']\"/"
">\n"
"                                </td>\n"
"                            </t>\n"
"                        </tr>\n"
"                    </t>\n"
"                </table>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 10px; font-"
"family: 'Courier New', Courier, Prestige, monospace\" data-o-mail-"
"quote=\"1\">\n"
"-- <br data-o-mail-quote=\"1\"/>\n"
"Automatic e-mail sent by Odoo.\n"
"</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" data-o-mail-quote-"
"container=\"1\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 12px; font-"
"family: Arial, Helvetica, sans-serif\">Veuillez trouver ci-dessous les actions effectuées "
"automatiquement pour le e-Reporting de la société <strong>\n"
"                    <t t-out=\"object.display_name\"/>\n"
"                </strong> configurée avec une périodicité de TVA <strong>\n"
"                    <t t-out=\"dict(object.fields_get('fr_vat_periodicity', "
"'selection')['fr_vat_periodicity']['selection'])[object."
"fr_vat_periodicity]\"/>\n"
"                </strong>.</p>\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; "
"width: 100%; text-align: center;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;"
"\">Type et période de e-Reporting</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;"
"\">Création</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;"
"\">Génération et envoi</th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"ctx['mail_coreinfo'].items()\" t-"
"as=\"line\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"line[0]\"/>\n"
"                            </td>\n"
"                            <t t-if=\"line[1]['created']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black; background-color: #a1ffba\">Créé</td>\n"
"                            </t>\n"
"                            <t t-if=\"not line[1]['created']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black;\">Déjà existant</td>\n"
"                            </t>\n"
"\n"
"                            <t t-if=\"line[1]['gen_sent']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black; background-color: #a1ffba\">Généré et envoyé avec succès</td>\n"
"                            </t>\n"
"                            <t t-if=\"not line[1]['gen_sent']\">\n"
"                                <td style=\"padding: 5px; border: 1px solid "
"black; background-color: #ffc694\">\n"
"                                    <t t-out=\"line[1]['gen_sent_error']\"/"
">\n"
"                                </td>\n"
"                            </t>\n"
"                        </tr>\n"
"                    </t>\n"
"                </table>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 10px; font-"
"family: 'Courier New', Courier, Prestige, monospace\" data-o-mail-"
"quote=\"1\">\n"
"-- <br data-o-mail-quote=\"1\"/>\n"
"E-mail automatique envoyé par Odoo.\n"
"</p>\n"
"            </div>\n"
"        "

